<?php

namespace App\Contracts\Services;

use App\Models\Withdrawal;
use Illuminate\Contracts\Pagination\LengthAwarePaginator;

interface WithdrawalServiceInterface
{
    // ---------------------------------------------------------------
    // Lifecycle
    // ---------------------------------------------------------------

    /**
     * طلب سحب نقدي عبر وكيل
     *
     * الخطوات:
     * 1. التحقق من كفاية الرصيد
     * 2. حساب العمولة من إعدادات الوكيل (snapshot)
     * 3. تجميد المبلغ في pending_balance
     * 4. إنشاء طلب withdrawal مع verification_code مشفر
     * 5. إرسال الكود للمستخدم عبر SMS
     *
     * @param  int   $walletId     محفظة المستخدم
     * @param  int   $agentId      الوكيل الذي سيصرف النقود
     * @param  float $amount       المبلغ المطلوب صرفه (بدون عمولة)
     * @return array{withdrawal: Withdrawal, commission: float, total: float}
     * @throws \App\Exceptions\Withdrawal\InsufficientBalanceException
     * @throws \App\Exceptions\Withdrawal\AgentInactiveException
     */
    public function request(int $walletId, int $agentId, float $amount): array;

    /**
     * إتمام السحب بعد التحقق من الكود
     *
     * الخطوات:
     * 1. التحقق من الكود وصلاحيته
     * 2. خصم total_amount من available_balance
     * 3. تحرير pending_balance
     * 4. إنشاء ledger entry + wallet_transaction
     * 5. إضافة العمولة لمحفظة الوكيل
     * 6. إنشاء commission_log
     *
     * @throws \App\Exceptions\Withdrawal\InvalidVerificationCodeException
     * @throws \App\Exceptions\Withdrawal\WithdrawalExpiredException
     * @throws \App\Exceptions\Withdrawal\WithdrawalAlreadyCompletedException
     */
    public function complete(int $withdrawalId, string $verificationCode): Withdrawal;

    /**
     * إلغاء طلب سحب (من المستخدم أو الإدارة)
     * يُحرر pending_balance
     *
     * @throws \App\Exceptions\Withdrawal\WithdrawalAlreadyCompletedException
     */
    public function cancel(int $withdrawalId, string $reason = ''): bool;

    // ---------------------------------------------------------------
    // Retrieval
    // ---------------------------------------------------------------

    public function findById(int $id): ?Withdrawal;

    public function getByWallet(int $walletId, int $perPage = 20): LengthAwarePaginator;

    public function getByAgent(int $agentId, int $perPage = 20): LengthAwarePaginator;

    // ---------------------------------------------------------------
    // Maintenance
    // ---------------------------------------------------------------

    /**
     * تنظيف الطلبات المنتهية الصلاحية وتحرير الـ pending balance
     * تُشغَّل عبر Scheduled Command
     */
    public function expireOldRequests(): int;
}
